{
  "name": "vt-interview-theme",
  "private": true,
  "scripts": {
    "build:css": "postcss src/css/input.css -o dist/theme.css",
    "build:js": "esbuild src/js/main.js --bundle --minify --outfile=dist/theme.js",
    "build": "npm run build:css && npm run build:js"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "postcss": "^8.4.0",
    "postcss-cli": "^11.0.0"
  }
}